diff --git a/tools/inv_checking_tool/src/handler_plugin.py b/tools/inv_checking_tool/src/handler_plugin.py
new file mode 100644
index 00000000..021cf584
--- /dev/null
+++ b/tools/inv_checking_tool/src/handler_plugin.py
@@ -0,0 +1,23 @@
+"""Loading of the optional user handler module (HANDLER_PY) for TraceReader.
+
+This is the only part of the trace reader that imports code chosen at run time. It is kept in its own
+module so that the rest of the reader has no dynamic imports and can be ported unit by unit.
+"""
+
+import os
+import sys
+from types import ModuleType
+
+
+def load_handler_module(handler_py: str) -> ModuleType | None:
+    """Import the handler file at ``handler_py`` the way TraceReader always has: by module name, with its
+    directory first on ``sys.path`` while importing. Returns ``None`` (with a warning) when it cannot be found."""
+    try:
+        sys.path.insert(0, os.path.dirname(handler_py))
+        try:
+            return __import__(os.path.basename(handler_py).replace(".py", ""))
+        finally:
+            sys.path.pop(0)
+    except ModuleNotFoundError:
