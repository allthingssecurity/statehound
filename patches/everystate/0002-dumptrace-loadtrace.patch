+    fn value_kinds() {
+        let ev = crate::eval::Evaluator::create();
+        let (a, b) = (Value::Model(model_value("a")), Value::Model(model_value("b")));
+        let s = |x: &str| Value::Str(str_id(x));
+        let t = |xs: Vec<Value>| Value::Tuple(TupleV::rc(xs));
+        let state = st(&[
+            ("i", Value::Int(-3)),
+            ("s", s("he\"llo\\\tx")),
+            ("b", Value::Bool(true)),
+            ("m", a.clone()),
+            ("q", t(vec![])),
+            ("tu", t(vec![Value::Int(1), s("a"), Value::Bool(false)])),
+            ("r", make_record(&[str_id("k"), str_id("l")], vec![Value::Int(1), s("q")])),
+            ("f0", make_fcn(&[Value::Int(0), Value::Int(1)], vec![Value::Int(5), Value::Int(6)])),
+            ("fm", make_fcn(&[a.clone(), b.clone()], vec![Value::Int(0), Value::Int(0)])),
+            ("ft", make_fcn(&[t(vec![Value::Int(1), Value::Int(2)])], vec![Value::Int(1)])),
+            ("se", SetV::of(vec![Value::Int(1), Value::Int(2)])),
+            ("es", SetV::of(vec![])),
+            ("iv", int_set(1, 3)),
+        ]);
+        let ce = CounterExample { states: vec![state], edges: vec![] };
+        // the names are listed in the order of TLC's sets of strings (first interned first), which in a
+        // test process depends on the other tests
+        let vars = format!("[{}]", ce.vars().iter().map(|v| format!("\"{}\"", v)).collect::<Vec<_>>().join(","));
+        let mut ids: Vec<StrId> = ce.states[0].iter().map(|(k, _)| str_id(k)).collect();
+        ids.sort_by_key(|i| i.0);
+        assert_eq!(ce.vars(), ids.iter().map(|i| str_of(*i).to_string()).collect::<Vec<_>>());
+        assert_eq!(
+            ce.to_json(ev).unwrap().replace(&vars, "VARS"),
+            "{\"counterexample\":{\"action\":[],\"state\":[[1,{\"i\":-3,\"s\":\"he\\\"llo\\\\\\tx\",\"b\":true,\"m\":\"a\",\"q\":[],\"tu\":[1,\"a\",false],\"r\":{\"k\":1,\"l\":\"q\"},\"f0\":{\"0\":5,\"1\":6},\"fm\":{\"a\":0,\"b\":0},\"ft\":{\"<<1, 2>>\":1},\"se\":[1,2],\"es\":[],\"iv\":[1,2,3]}]]},\"vars\":VARS}"
+        );
+        assert_eq!(
+            ce.to_tla("T.tla"),
+            "---- MODULE T ----\nLOCAL INSTANCE TLC\n\nCounterExample == \n\t[action |-> {}, state |-> {<<1, [i |-> -3, s |-> \"he\\\"llo\\\\\\tx\", b |-> TRUE, m |-> a, q |-> <<>>, tu |-> <<1, \"a\", FALSE>>, r |-> [k |-> 1, l |-> \"q\"], f0 |-> (0 :> 5 @@ 1 :> 6), fm |-> (a :> 0 @@ b :> 0), ft |-> (<<1, 2>> :> 1), se |-> {1, 2}, es |-> {}, iv |-> 1..3]>>}]\n\n===="
+        );
+    }
