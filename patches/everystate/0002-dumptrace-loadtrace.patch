+// ---------------------------------------------------------------------------------------------
+// -loadTrace json
+
+/// The file of `-loadTrace json`, for every model built in this process (the workers of a parallel
+/// search build their own model and read it too).
+static LOAD_TRACE: Mutex<Option<String>> = Mutex::new(None);
+
+pub fn set_load_trace(file: Option<String>) {
+    *LOAD_TRACE.lock().unwrap_or_else(|e| e.into_inner()) = file;
+}
+pub fn load_trace() -> Option<String> {
+    LOAD_TRACE.lock().unwrap_or_else(|e| e.into_inner()).clone()
+}
+
+/// A trace read with `-loadTrace json`: the states of `counterexample.state` (by position), the names
+/// of `vars` (sorted as TLC's set of them) and the state the lasso returns to (0: no lasso).
+struct Loaded {
+    states: Vec<Value>,
+    vars: Vec<StrId>,
+    lasso_target: i64,
+}
+
+thread_local! {
+    static LOADED: RefCell<Option<Rc<Result<Loaded, String>>>> = const { RefCell::new(None) };
+}
+
+/// Reads the trace file for the model being built on this thread. A file that cannot be read or does
+/// not have the shape of a dumped trace is reported when the constraint is first evaluated, as TLC does.
+pub fn prepare_load_trace(file: &str) {
+    let r = read_loaded(file);
+    LOADED.with(|l| *l.borrow_mut() = Some(Rc::new(r)));
+}
+
+fn read_loaded(file: &str) -> Result<Loaded, String> {
+    let msg = |e: Box<Fail>| match *e {
+        Fail::Tla(t) => t.msg,
+        _ => "internal error".to_string(),
+    };
+    let dump = match crate::stdlib::json_deserialize(file) {
+        Ok(v) => v,
+        Err(e) => {
+            return Err(format!(
+                "Attempted to apply the operator overridden by the Java method\npublic static tlc2.value.IValue tlc2.overrides.Json.deserialize(tlc2.value.impl.StringValue) throws java.io.IOException,\nbut it produced the following error:\n{}",
+                msg(e)
+            ))
+        }
+    };
+    let field = |v: &Value, f: &str| -> Result<Value, String> {
+        match v {
+            Value::Record(r) => r.get(str_id(f)).cloned().ok_or_else(|| format!("Attempted to access nonexistent field '{}' of record\n{}", f, fmt(v))),
+            _ => Err(format!("Attempted to apply the operator \"{}\" to the non-record value\n{}", f, fmt(v))),
+        }
+    };
+    let elems = |v: &Value| -> Result<Vec<Value>, String> {
+        match v {
+            Value::Tuple(t) => Ok(t.to_vec()),
+            _ => Err(format!("The trace file {} does not hold a trace dumped with -dumpTrace json:\n{}", file, fmt(v))),
+        }
+    };
+    let ce = field(&dump, "counterexample")?;
+    let mut states = vec![];
+    for s in elems(&field(&ce, "state")?)? {
+        match &s {
+            Value::Tuple(t) if t.len() >= 2 => states.push(t[1].clone()),
+            _ => return Err(format!("Attempted to apply function:\n{}\nto argument 2, which is not in the domain of the function.", fmt(&s))),
+        }
+    }
+    let mut vars: Vec<StrId> = vec![];
+    for v in elems(&field(&dump, "vars")?)? {
+        match v {
+            Value::Str(s) => {
+                if !vars.contains(&s) {
+                    vars.push(s)
+                }
+            }
+            x => return Err(format!("The trace file {} names a variable that is not a string: {}", file, fmt(&x))),
+        }
+    }
+    vars.sort_by_key(|s| s.0);
+    // the edge that closes a lasso is the one that does not lead to a later state
+    let num = |v: &Value| -> Option<i64> {
+        match v {
+            Value::Tuple(t) => match t.first() {
+                Some(Value::Int(n)) => Some(*n),
+                _ => None,
+            },
+            _ => None,
+        }
+    };
+    let mut lasso_target = 0;
+    for a in elems(&field(&ce, "action")?)? {
+        if let Value::Tuple(t) = &a {
+            if t.len() >= 3 {
+                if let (Some(from), Some(to)) = (num(&t[0]), num(&t[2])) {
+                    if to <= from {
+                        lasso_target = to;
+                        break;
+                    }
+                }
+            }
+        }
+    }
+    Ok(Loaded { states, vars, lasso_target })
+}
+
+fn loaded() -> R<Rc<Result<Loaded, String>>> {
+    match LOADED.with(|l| l.borrow().clone()) {
+        Some(l) => Ok(l),
+        None => eval_err("No trace was loaded with -loadTrace.".into()),
+    }
+}
+
+/// `_JsonTraceConstraint`: the state at level L agrees with the L-th state of the trace on the
+/// variables that are both variables of the spec and of the trace (any state past the end of the trace
+/// is allowed).
+pub fn constraint(ev: &Evaluator) -> R<Value> {
+    ev.st_touch.set(ev.st_touch.get() + 1);
+    let l = loaded()?;
+    let lt = match &*l {
+        Ok(lt) => lt,
+        Err(m) => return eval_err(m.clone()),
+    };
+    let level = ev.stats.level.get();
+    if level < 1 || level as usize > lt.states.len() {
+        return Ok(Value::Bool(true));
+    }
+    let want = &lt.states[level as usize - 1];
+    let cur = ev.cur.borrow().clone();
+    let names = ev.var_names.borrow().clone();
+    for v in &lt.vars {
+        let vs = str_of(*v);
+        let i = match names.iter().position(|n| *name_str(*n) == *vs) {
+            Some(i) => i,
+            None => continue,
+        };
+        let w = match want {
+            Value::Record(r) => match r.get(*v) {
+                Some(w) => w.clone(),
+                None => return eval_err(format!("Attempted to access nonexistent field '{}' of record\n{}", vs, fmt(want))),
+            },
+            _ => return eval_err(format!("Attempted to apply the operator \"{}\" to the non-record value\n{}", vs, fmt(want))),
+        };
+        if !tlc_eq(&cur.get(i), &w)? {
+            return Ok(Value::Bool(false));
+        }
+    }
+    Ok(Value::Bool(true))
+}
+
+fn fcn_like(v: &Value) -> bool {
+    matches!(v, Value::Tuple(_) | Value::Record(_) | Value::Fcn(_))
+}
+
+/// TLC's `a.equals(b)` for a value of the state and a value read from JSON (arrays are tuples, objects
+/// records). everystate keeps functions in canonical form (domain 1..n: tuple; strings: record), where
+/// two different forms are simply unequal; TLC compares the domains of a function and a record or tuple
+/// element by element, which fails for an integer and a string (a function with domain 0..n against a
+/// JSON object, say). The other values compare as everywhere else.
+fn tlc_eq(a: &Value, b: &Value) -> R<bool> {
+    match (a, b) {
+        (Value::Tuple(x), Value::Tuple(y)) => {
+            if x.len() != y.len() {
+                return Ok(false);
+            }
+            for i in 0..x.len() {
+                if !tlc_eq(&x[i], &y[i])? {
+                    return Ok(false);
+                }
+            }
+            Ok(true)
+        }
+        (Value::Record(x), Value::Record(y)) => {
+            if x.names[..] != y.names[..] {
+                return Ok(false);
+            }
+            for i in 0..x.vals.len() {
+                if !tlc_eq(&x.vals[i], &y.vals[i])? {
+                    return Ok(false);
+                }
+            }
+            Ok(true)
+        }
+        (Value::Fcn(x), Value::Fcn(y)) => {
+            if x.dom.len() != y.dom.len() {
+                return Ok(false);
+            }
+            for i in 0..x.dom.len() {
+                if !val_eq(&x.dom[i], &y.dom[i])? {
+                    return Ok(false);
+                }
+            }
+            for i in 0..x.vals.len() {
+                if !tlc_eq(&x.vals[i], &y.vals[i])? {
+                    return Ok(false);
+                }
+            }
+            Ok(true)
+        }
+        _ if fcn_like(a) && fcn_like(b) => fcn_eq(a, b),
+        _ => val_eq(a, b),
+    }
+}
+
+/// FcnRcdValue / RecordValue / TupleValue.equals for two functions of different canonical forms.
+fn fcn_eq(a: &Value, b: &Value) -> R<bool> {
+    let not_int = |d: &Value| eval_err(format!("Attempted to compare an integer with non-integer:\n{}.", fmt(d)));
+    let pairs = |v: &Value| -> R<(Vec<Value>, Vec<Value>)> { Ok((domain_elems(v)?.to_vec(), fcn_values(v)?.to_vec())) };
+    match a {
+        // TupleValue.equals: a non-tuple is compared with the tuple as a function (domain 1..n)
+        Value::Tuple(_) => fcn_eq_intv(a, 1, b),
+        // RecordValue.equals: anything that is not a record is an error
+        Value::Record(_) => eval_err(format!("Attempted to check equality of record:\n{}\nwith non-record\n{}", fmt(a), fmt(b))),
+        _ => {
+            let (da, va) = pairs(a)?;
+            let (db, vb) = pairs(b)?;
+            // TLC keeps the domain of a function as an interval (FcnRcdValue.intv) when it was built over
+            // one, [i \in 0..N |-> ..], and as an array when it was built with :> and @@; the form is not
+            // kept here, so consecutive integers count as an interval, except a single one (d :> v)
+            let lo = match da.first() {
+                Some(Value::Int(l)) if da.len() > 1 && da.iter().enumerate().all(|(i, d)| matches!(d, Value::Int(x) if *x == l + i as i64)) => Some(*l),
+                _ => None,
+            };
+            if let Some(l) = lo {
+                return fcn_eq_intv(a, l, b);
+            }
+            if da.len() != db.len() {
+                return Ok(false);
+            }
+            if matches!(b, Value::Tuple(_)) {
+                for (i, d) in da.iter().enumerate() {
+                    match d {
+                        Value::Int(x) if *x == 1 + i as i64 => {}
+                        Value::Int(_) => return Ok(false),
+                        _ => return not_int(d),
+                    }
+                }
+            } else {
+                for i in 0..da.len() {
+                    if !scalar_eq(&da[i], &db[i])? {
+                        return Ok(false);
+                    }
+                }
+            }
+            for i in 0..va.len() {
+                if !tlc_eq(&va[i], &vb[i])? {
+                    return Ok(false);
+                }
+            }
+            Ok(true)
+        }
+    }
+}
+
+/// IntValue / StringValue.equals for the elements of two domains, with TLC's messages.
+fn scalar_eq(a: &Value, b: &Value) -> R<bool> {
+    match (a, b) {
+        (Value::Int(_), Value::Int(_) | Value::Model(_)) | (Value::Str(_), Value::Str(_) | Value::Model(_)) => val_eq(a, b),
+        (Value::Int(_), _) => eval_err(format!("Attempted to check equality of integer {} with non-integer:\n{}", fmt(a), fmt(b))),
+        (Value::Str(_), _) => eval_err(format!("Attempted to check equality of string {} with non-string:\n{}", fmt(a), fmt(b))),
+        _ => tlc_eq(a, b),
+    }
+}
+
+/// FcnRcdValue.equals of a function whose domain is the interval lo..lo+n-1 with another function.
+fn fcn_eq_intv(a: &Value, lo: i64, b: &Value) -> R<bool> {
+    let va = fcn_values(a)?.to_vec();
+    let (db, vb) = (domain_elems(b)?.to_vec(), fcn_values(b)?.to_vec());
+    if matches!(b, Value::Tuple(_)) {
+        // two intervals: equal only if they are the same interval
+        if !(db.len() == va.len() && (va.is_empty() || lo == 1)) {
+            return Ok(false);
+        }
+    } else {
+        if db.len() != va.len() {
+            return Ok(false);
+        }
+        for (i, d) in db.iter().enumerate() {
+            match d {
+                Value::Int(x) if *x == lo + i as i64 => {}
+                Value::Int(_) => return Ok(false),
+                _ => return eval_err(format!("Attempted to compare an integer with non-integer:\n{}.", fmt(d))),
+            }
+        }
+    }
+    for i in 0..va.len() {
+        if !tlc_eq(&va[i], &vb[i])? {
+            return Ok(false);
+        }
+    }
+    Ok(true)
+}
+
+/// `_JsonTraceView`: <<level, state>>, where a level past the end of the trace is that of the state the
+/// lasso returns to (so that the lasso closes).
+pub fn view(ev: &Evaluator) -> R<Value> {
+    ev.st_touch.set(ev.st_touch.get() + 1);
+    let l = loaded()?;
+    let lt = match &*l {
+        Ok(lt) => lt,
+        Err(m) => return eval_err(m.clone()),
+    };
+    let level = ev.stats.level.get();
+    let at = if level <= lt.states.len() as i64 { level } else { lt.lasso_target };
+    let cur = ev.cur.borrow().clone();
+    let names: Vec<StrId> = ev.var_names.borrow().iter().map(|n| str_id(&name_str(*n))).collect();
+    let vals: Vec<Value> = (0..names.len()).map(|i| cur.get(i)).collect();
+    Ok(Value::Tuple(TupleV::rc(vec![Value::Int(at), make_record(&names, vals)])))
+}
