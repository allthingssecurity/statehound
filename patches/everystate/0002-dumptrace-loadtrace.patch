+    /// Edges: an action with parameters (TLC's context and parameters fields) and the edge that closes
+    /// a lasso.
+    #[test]
+    fn edges() {
+        let ev = crate::eval::Evaluator::create();
+        let x = |n: i64| st(&[("x", Value::Int(n))]);
+        let a = CeAction { name: "A".into(), loc: [6, 12, 6, 33], module: "M".into(), params: vec![("p".into(), Value::Model(model_value("p1"))), ("q".into(), Value::Int(1))] };
+        let ce = CounterExample { states: vec![x(0), x(1)], edges: vec![(0, a, 1), (1, CeAction::unnamed(), 1)] };
+        assert_eq!(
+            ce.to_json(ev).unwrap(),
+            "{\"counterexample\":{\"action\":[[[1,{\"x\":0}],{\"name\":\"A\",\"location\":{\"beginLine\":6,\"beginColumn\":12,\"endLine\":6,\"endColumn\":33,\"module\":\"M\"},\"context\":{\"p\":\"p1\",\"q\":1},\"parameters\":[\"p\",\"q\"]},[2,{\"x\":1}]],[[2,{\"x\":1}],{\"name\":\"UnnamedAction\",\"location\":{\"beginLine\":0,\"beginColumn\":0,\"endLine\":0,\"endColumn\":0,\"module\":\"--TLA+ BUILTINS--\"}},[2,{\"x\":1}]]],\"state\":[[1,{\"x\":0}],[2,{\"x\":1}]]},\"vars\":[\"x\"]}"
+        );
+        assert!(ce.to_tla("o").contains("[name |-> \"A\", location |-> [beginLine |-> 6, beginColumn |-> 12, endLine |-> 6, endColumn |-> 33, module |-> \"M\"], context |-> [p |-> p1, q |-> 1], parameters |-> <<\"p\", \"q\">>]"));
+        // a variable a simulation left unassigned cannot be encoded (TLC's Json override fails on null)
+        let un = CounterExample { states: vec![st(&[("x", Value::Undef)])], edges: vec![] };
+        assert!(un.to_json(ev).is_err());
+    }
+
+    /// The equality of -loadTrace: values of the state against values read from JSON, as TLC compares them.
+    #[test]
+    fn replay_equality() {
+        let _ = crate::eval::Evaluator::create();
+        let s = |x: &str| Value::Str(str_id(x));
+        let t = |xs: Vec<Value>| Value::Tuple(TupleV::rc(xs));
+        let rec = |ks: &[&str], vs: Vec<Value>| make_record(&ks.iter().map(|k| str_id(k)).collect::<Vec<_>>(), vs);
+        assert!(tlc_eq(&t(vec![Value::Int(1)]), &t(vec![Value::Int(1)])).unwrap());
+        assert!(!tlc_eq(&Value::Model(model_value("p1")), &s("p1")).unwrap());
+        // a set against the array JSON has for it
+        assert!(tlc_eq(&SetV::of(vec![Value::Int(1)]), &t(vec![Value::Int(1)])).is_err());
+        // a function of model values against an object: unequal domains
+        let fm = make_fcn(&[Value::Model(model_value("a"))], vec![Value::Int(0)]);
+        assert!(!tlc_eq(&fm, &rec(&["a"], vec![Value::Int(0)])).unwrap());
+        // a function with domain 0..1 against an object: an integer compared with a string
+        let f0 = make_fcn(&[Value::Int(0), Value::Int(1)], vec![Value::Int(0), Value::Int(0)]);
+        let e = tlc_eq(&f0, &rec(&["0", "1"], vec![Value::Int(0), Value::Int(0)])).unwrap_err();
+        assert!(matches!(&*e, Fail::Tla(t) if t.msg.starts_with("Attempted to compare an integer with non-integer:\n\"")));
+        // nested: records whose fields are compared the same way
+        assert!(tlc_eq(&rec(&["k"], vec![t(vec![s("x")])]), &rec(&["k"], vec![t(vec![s("x")])])).unwrap());
+        assert!(!tlc_eq(&rec(&["k"], vec![Value::Int(1)]), &rec(&["l"], vec![Value::Int(1)])).unwrap());
+    }
+
+    #[test]
+    fn tla_module_name() {
+        let ce = CounterExample { states: vec![st(&[("x", Value::Int(0))])], edges: vec![] };
+        assert_eq!(ce.to_tla("sub/x.tla.tla"), "---- MODULE sub/x.tla ----\nLOCAL INSTANCE TLC\n\nCounterExample == \n\t[action |-> {}, state |-> {<<1, [x |-> 0]>>}]\n\n====");
+        assert!(ce.to_tla("out").starts_with("---- MODULE out ----\n"));
+    }
+}
