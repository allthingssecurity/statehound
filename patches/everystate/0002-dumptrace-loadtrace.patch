+test('options: TLC\'s errors for a missing or unknown format, clear errors for formats not written', () => {
+  let r = run(['-dumpTrace', 'foo', 'x.json', 'Dead.tla']);
+  assert.equal(r.code, 1);
+  assert.equal(r.out, 'Error: Error: Unknown format foo given to -dumpTrace.\n');
+  r = run(['-loadTrace', 'foo', 'x.json', 'Dead.tla']);
+  assert.equal(r.out, 'Error: Error: Unknown format foo given to -loadTrace.\n');
+  r = run(['Dead.tla', '-dumpTrace', 'json']);
+  assert.equal(r.out, 'Error: Error: A format and a file name for dumping traces required.\n');
+  r = run(['-dumpTrace', 'tlc', 'x.bin', 'Dead.tla']);
+  assert.equal(r.code, 1);
+  assert.match(r.out, /-dumpTrace tlc .* is not supported by everystate/);
+  r = run(['-loadTrace', 'tlc', 'x.bin', 'Dead.tla']);
