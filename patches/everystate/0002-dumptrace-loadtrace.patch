+    const c = CASES.find(c => c.name === name)!;
+    fs.writeFileSync(path.join(dir, 'in_' + name + '.json'), c.json);
+    const r = run(['-workers', '1', ...c.flags, '-config', name + '.cfg', '-loadTrace', 'json', 'in_' + name + '.json', '-dumpTrace', 'json', 'out_' + name + '.json', name + '.tla']);
+    assert.equal(r.code, c.code, r.out);
+    assert.equal(read('out_' + name + '.json'), c.json, name);
+  }
+  // TLC, the same: the replay is restricted to the trace (3 states, not the 4 of the spec)
+  let r = run(['-workers', '1', '-loadTrace', 'json', 'in_LiveBack.json', 'LiveBack.tla']);
+  assert.match(r.out, /4 states generated, 3 distinct states found, 0 states left on queue./);
+  // a model value never equals the string the JSON file has for it: nothing matches after the initial state
+  fs.writeFileSync(path.join(dir, 'in_Param.json'), CASES.find(c => c.name === 'Param')!.json);
+  r = run(['-workers', '1', '-loadTrace', 'json', 'in_Param.json', '-dumpTrace', 'json', 'out_Param.json', 'Param.tla']);
+  assert.equal(r.code, 0, r.out);
+  assert.match(r.out, /6 states generated, 1 distinct states found, 0 states left on queue./);
+  assert.ok(!fs.existsSync(path.join(dir, 'out_Param.json')));
+  // a set in the state against the array of the file: TLC's equality error
+  fs.writeFileSync(path.join(dir, 'in_V.json'), CASES.find(c => c.name === 'V')!.json);
+  r = run(['-workers', '1', '-loadTrace', 'json', 'in_V.json', 'V.tla']);
