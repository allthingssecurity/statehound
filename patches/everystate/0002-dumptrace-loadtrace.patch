+test('the line is printed after the trace and before the statistics, unframed with -tool', () => {
+  let r = run(['-workers', '1', '-dumpTrace', 'json', 'd1.json', 'Dead.tla']);
+  assert.match(r.out, /x = 2\n\n"CounterExample written: d1.json"\n3 states generated/);
+  r = run(['-workers', '1', 'LiveBack.tla', '-dumpTrace', 'json', 'l1.json']);
+  assert.match(r.out, /Back to state 1: <Inc line 5, col 8 to line 5, col 23 of module LiveBack>\n\n"CounterExample written: l1.json"\nFinished checking temporal properties/);
+  r = run(['-workers', '1', '-tool', '-dumpTrace', 'json', 'd2.json', 'Dead.tla']);
+  assert.match(r.out, /@!@!@ENDMSG 2217 @!@!@\n"CounterExample written: d2.json"\n@!@!@STARTMSG/);
+  // simulation: after its statistics
+  r = run(['-simulate', '-seed', '1', '-dumpTrace', 'json', 's1.json', 'Dead.tla']);
+  assert.match(r.out, /Simulation using seed 1 and aril 0\n"CounterExample written: s1.json"\n/);
+  assert.equal(read('s1.json'), CASES.find(c => c.name === 'Dead')!.json);
+  // -json: the file is written, the single JSON line stays alone
+  r = run(['-json', '-dumpTrace', 'json', 'j1.json', 'Dead.tla']);
+  assert.equal(JSON.parse(r.out.trim()).status, 'deadlock');
+  assert.equal(read('j1.json'), CASES.find(c => c.name === 'Dead')!.json);
+});
