@@ -0,0 +1,769 @@
+//! TLC's `-dumpTrace FORMAT FILE` and `-loadTrace FORMAT FILE`.
+//!
+//! TLC implements both with TLA+ modules of tla2tools.jar. `-dumpTrace json F` adds the POSTCONDITION
+//! `_JsonTrace`, which serializes TLCExt!CounterExample (a record of a set of `<<n, state>>` pairs and a
+//! set of `<<from, action, to>>` edges) with Json!JsonSerialize, together with the variable names, and
+//! prints "CounterExample written: F"; `-dumpTrace tla F` writes ToString(CounterExample) as a module.
+//! `-loadTrace json F` adds the CONSTRAINT `_JsonTraceConstraint` (the state at level L agrees with the
+//! L-th state of the file on the variables the two have in common) and, unless the configuration has a
+//! VIEW, the VIEW `_JsonTraceView` (<<level, state>>, with the level past the end of a lasso mapped to
+//! the state the lasso returns to), so that model checking replays the trace.
+//!
+//! Here the counterexample is built from the checker's result and encoded from the values themselves,
+//! with the encoder of the Json module (`community::to_json`) and TLC's value printer (`fmt`), and
+//! the constraint and view of `-loadTrace` are native operators of a built-in module `_JsonTrace`.
+use crate::checker::CheckResult;
+use crate::cli::{alias_fields, Reporter};
+use crate::eval::{Evaluator, StateRef};
+use crate::intern::*;
+use crate::model::Model;
+use crate::value::*;
+use std::cell::RefCell;
+use std::rc::Rc;
+use std::sync::Mutex;
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum DumpFormat {
+    Json,
+    Tla,
+}
+
+/// One `-dumpTrace FORMAT FILE` of the command line.
+#[derive(Clone, Debug)]
+pub struct DumpTrace {
+    pub format: DumpFormat,
+    pub file: String,
+}
+
+/// The format of `-dumpTrace FORMAT` (TLC compares case-insensitively). Err: the message for an unknown
+/// format (TLC's wording) or for one of TLC's other formats, which everystate does not write.
+pub fn dump_format(fmt: &str) -> Result<DumpFormat, String> {
+    match fmt.to_ascii_lowercase().as_str() {
+        "json" => Ok(DumpFormat::Json),
+        "tla" => Ok(DumpFormat::Tla),
+        "tlc" => Err("Error: -dumpTrace tlc (TLC's binary trace format, Java value serialization) is not supported by everystate; use -dumpTrace json or -dumpTrace tla.".into()),
+        "tlcplain" | "tlctespec" | "tlcaction" | "dot" => Err(format!("Error: -dumpTrace {} is not supported by everystate; use -dumpTrace json or -dumpTrace tla.", fmt)),
+        _ => Err(format!("Error: Unknown format {} given to -dumpTrace.", fmt)),
+    }
+}
+
+/// Checks the format of `-loadTrace FORMAT`. Only TLC's JSON traces can be loaded.
+pub fn load_format(fmt: &str) -> Result<(), String> {
+    match fmt.to_ascii_lowercase().as_str() {
+        "json" => Ok(()),
+        "tlc" => Err("Error: -loadTrace tlc is not supported by everystate: TLC's binary trace format is Java value serialization tied to TLC's internal string table. Dump the trace with -dumpTrace json and load it with -loadTrace json.".into()),
+        _ => Err(format!("Error: Unknown format {} given to -loadTrace.", fmt)),
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// the counterexample
+
+/// The action of an edge of a counterexample (TLC's `RecordValue(Action)`).
+#[derive(Clone)]
+pub struct CeAction {
+    pub name: String,
+    pub loc: Loc,
+    pub module: String,
+    /// the parameters of the action's definition and their values (TLC's `context` and `parameters`)
+    pub params: Vec<(String, Value)>,
+}
+impl CeAction {
+    /// `Action.UNKNOWN`, which TLC records for a stuttering step it has no action for.
+    fn unnamed() -> CeAction {
+        CeAction { name: "UnnamedAction".into(), loc: [0; 4], module: "--TLA+ BUILTINS--".into(), params: vec![] }
+    }
+    fn of(model: &Model, a: Option<usize>) -> CeAction {
+        match a.and_then(|a| model.actions.get(a)) {
+            Some(a) => CeAction { name: a.name.clone(), loc: a.loc, module: a.module.clone(), params: a.param_vals.clone() },
+            None => CeAction::unnamed(),
+        }
+    }
+}
+
+/// TLCExt!CounterExample: the states (record fields in TLC's order; `Value::Undef` for a variable a
+/// simulation left unassigned) and the edges between them (indices into `states`).
+pub struct CounterExample {
+    pub states: Vec<Vec<(String, Value)>>,
+    pub edges: Vec<(usize, CeAction, usize)>,
+}
+
+impl CounterExample {
+    /// The counterexample TLC hands to its postconditions for this result, or `None` when TLC has none:
+    /// in model checking only for violations (invariants, properties, deadlock), in simulation for every
+    /// error with a behaviour.
+    pub fn of(model: &Model, res: &CheckResult, sim: bool) -> Option<CounterExample> {
+        let tr = res.trace.as_ref()?;
+        if tr.is_empty() {
+            return None;
+        }
+        let init_only = matches!(res.status, "invariant-init" | "implied-init");
+        if sim {
+            // an error while working on an initial state, or a check TLC's simulator does not make
+            if res.status == "implied-init" || (tr.len() == 1 && tr[0].id == -1 && tr[0].action.is_none() && !init_only) {
+                return None;
+            }
+        } else if !matches!(res.status, "invariant" | "invariant-init" | "implied-init" | "deadlock" | "action-property" | "liveness") {
+            return None;
+        }
+        let live = res.status == "liveness";
+        let plain = |s: &StateRef| -> Vec<(String, Value)> { model.vars.iter().enumerate().map(|(i, v)| (v.name.to_string(), s.get(i))).collect() };
+        let n = tr.len();
+        let mut states = Vec::with_capacity(n);
+        for i in 0..n {
+            let s = &tr[i].state;
+            // TLC evaluates the ALIAS for the states of the counterexample except for a violation by an
+            // initial state and a lasso of model checking; the state paired with the last one is itself.
+            // (Its simulator pairs each state of a lasso with the one before.)
+            let fields = if model.alias.is_none() || init_only || (live && !sim) {
+                None
+            } else if live {
+                alias_fields(model, s, &tr[i.saturating_sub(1)].state)
+            } else {
+                alias_fields(model, s, tr.get(i + 1).map_or(s, |t| &t.state))
+            };
+            states.push(fields.unwrap_or_else(|| plain(s)));
+        }
+        let mut edges: Vec<(usize, CeAction, usize)> = (1..n).map(|i| (i - 1, CeAction::of(model, tr[i].action), i)).collect();
+        if live {
+            match res.loop_to {
+                Some(l) if l >= 0 && (l as usize) < n => edges.push((n - 1, CeAction::of(model, res.loop_action), l as usize)),
+                Some(_) => {
+                    // stuttering: model checking names the action of the last state (none for an initial
+                    // state); the simulator has no action for it
+                    let a = if sim || n == 1 { CeAction::unnamed() } else { CeAction::of(model, tr[n - 1].action) };
+                    edges.push((n - 1, a, n - 1));
+                }
+                None => {}
+            }
+        }
+        Some(CounterExample { states, edges })
+    }
+
+    /// `UNION { DOMAIN trace[i] : i \in DOMAIN trace }`: the field names, in the order of TLC's sets of
+    /// strings.
+    pub fn vars(&self) -> Vec<String> {
+        let mut ids: Vec<StrId> = vec![];
+        for s in &self.states {
+            for (k, _) in s {
+                let id = str_id(k);
+                if !ids.contains(&id) {
+                    ids.push(id);
+                }
+            }
+        }
+        ids.sort_by_key(|i| i.0);
+        ids.into_iter().map(|i| str_of(i).to_string()).collect()
+    }
+
+    /// The file `-dumpTrace json` writes: `{"counterexample":{"action":[..],"state":[..]},"vars":[..]}`.
+    /// Err: the message of the Json module when a value cannot be encoded.
+    pub fn to_json(&self, ev: &Evaluator) -> R<String> {
+        let state_json = |i: usize, o: &mut String| -> R<()> {
+            o.push('[');
+            o.push_str(&(i + 1).to_string());
+            o.push_str(",{");
+            for (j, (k, v)) in self.states[i].iter().enumerate() {
+                if j > 0 {
+                    o.push(',');
+                }
+                crate::community::json_str(k, o);
+                o.push(':');
+                if matches!(v, Value::Undef) {
+                    // what Gson makes of TLC's null value
+                    return eval_err(
+                        "Attempted to apply the operator overridden by the Java method\npublic static synchronized tlc2.value.impl.BoolValue tlc2.overrides.Json.serialize(tlc2.value.impl.StringValue,tlc2.value.impl.Value) throws java.io.IOException,\nbut it produced the following error:\nCannot invoke \"Object.getClass()\" because \"<parameter1>\" is null".into(),
+                    );
+                }
+                o.push_str(&crate::community::to_json(ev, v)?);
+            }
+            o.push_str("}]");
+            Ok(())
+        };
+        let mut o = String::from("{\"counterexample\":{\"action\":[");
+        for (k, (from, a, to)) in self.edges.iter().enumerate() {
+            if k > 0 {
+                o.push(',');
+            }
+            o.push('[');
+            state_json(*from, &mut o)?;
+            o.push_str(",{\"name\":");
+            crate::community::json_str(&a.name, &mut o);
+            o.push_str(&format!(",\"location\":{{\"beginLine\":{},\"beginColumn\":{},\"endLine\":{},\"endColumn\":{},\"module\":", a.loc[0], a.loc[1], a.loc[2], a.loc[3]));
+            crate::community::json_str(&a.module, &mut o);
+            o.push('}');
+            if !a.params.is_empty() {
+                o.push_str(",\"context\":{");
+                for (j, (p, v)) in a.params.iter().enumerate() {
+                    if j > 0 {
+                        o.push(',');
+                    }
+                    crate::community::json_str(p, &mut o);
+                    o.push(':');
+                    o.push_str(&crate::community::to_json(ev, v)?);
+                }
+                o.push_str("},\"parameters\":[");
+                for (j, (p, _)) in a.params.iter().enumerate() {
+                    if j > 0 {
+                        o.push(',');
+                    }
+                    crate::community::json_str(p, &mut o);
+                }
+                o.push(']');
+            }
+            o.push_str("},");
+            state_json(*to, &mut o)?;
+            o.push(']');
+        }
+        o.push_str("],\"state\":[");
+        for i in 0..self.states.len() {
+            if i > 0 {
+                o.push(',');
+            }
+            state_json(i, &mut o)?;
+        }
+        o.push_str("]},\"vars\":[");
+        for (j, v) in self.vars().iter().enumerate() {
+            if j > 0 {
+                o.push(',');
+            }
+            crate::community::json_str(v, &mut o);
+        }
+        o.push_str("]}");
+        Ok(o)
+    }
+
+    /// The file `-dumpTrace tla FILE` writes: a module named after FILE (its first ".tla" removed, as
+    /// TLC's ReplaceFirstSubSeq does) defining `CounterExample` as TLC prints the value.
+    pub fn to_tla(&self, file: &str) -> String {
+        let state_tla = |i: usize, o: &mut String| {
+            o.push_str(&format!("<<{}, [", i + 1));
+            for (j, (k, v)) in self.states[i].iter().enumerate() {
+                if j > 0 {
+                    o.push_str(", ");
+                }
+                o.push_str(k);
+                o.push_str(" |-> ");
+                if matches!(v, Value::Undef) {
+                    o.push_str("null");
+                } else {
+                    fmt_into(v, o);
+                }
+            }
+            o.push_str("]>>");
+        };
+        let mut o = String::from("[action |-> {");
+        for (k, (from, a, to)) in self.edges.iter().enumerate() {
+            if k > 0 {
+                o.push_str(", ");
+            }
+            o.push_str("<<");
+            state_tla(*from, &mut o);
+            o.push_str(", [name |-> ");
+            fmt_str(&a.name, &mut o);
+            o.push_str(&format!(", location |-> [beginLine |-> {}, beginColumn |-> {}, endLine |-> {}, endColumn |-> {}, module |-> ", a.loc[0], a.loc[1], a.loc[2], a.loc[3]));
+            fmt_str(&a.module, &mut o);
+            o.push(']');
+            if !a.params.is_empty() {
+                o.push_str(", context |-> [");
+                for (j, (p, v)) in a.params.iter().enumerate() {
+                    if j > 0 {
+                        o.push_str(", ");
+                    }
+                    o.push_str(p);
+                    o.push_str(" |-> ");
+                    fmt_into(v, &mut o);
+                }
+                o.push_str("], parameters |-> <<");
+                for (j, (p, _)) in a.params.iter().enumerate() {
+                    if j > 0 {
+                        o.push_str(", ");
+                    }
+                    fmt_str(p, &mut o);
+                }
+                o.push_str(">>");
+            }
+            o.push_str("], ");
+            state_tla(*to, &mut o);
+            o.push_str(">>");
+        }
+        o.push_str("}, state |-> {");
+        for i in 0..self.states.len() {
+            if i > 0 {
+                o.push_str(", ");
+            }
+            state_tla(i, &mut o);
+        }
+        o.push_str("}]");
+        let module = file.replacen(".tla", "", 1);
+        format!("---- MODULE {} ----\nLOCAL INSTANCE TLC\n\nCounterExample == \n\t{}\n\n====", module, o)
+    }
+}
+
+/// Writes the counterexample of `res` to the files of the `-dumpTrace` options, in their order, and
+/// prints TLC's line for each file written (not with `-json`, whose output is a single JSON object).
+/// Nothing is written when TLC has no counterexample for the result. As in TLC, a dump that fails
+/// stops the ones after it.
+pub(crate) fn write_dumps(rep: &Reporter, model: &Model, res: &CheckResult, dumps: &[DumpTrace], sim: bool, json: bool) {
+    if dumps.is_empty() {
+        return;
+    }
+    let ce = match CounterExample::of(model, res, sim) {
+        Some(c) => c,
+        None => return,
+    };
+    for d in dumps {
+        let (text, at) = match d.format {
+            DumpFormat::Json => (ce.to_json(model.ev), "_JsonTrace at line 11, col 5 to line 15, col 63 of module _JsonTrace"),
+            DumpFormat::Tla => (Ok(ce.to_tla(&d.file)), "_TLAPlusCounterExample at line 19, col 5 to line 28, col 75 of module _TLAPlusCounterExample"),
+        };
+        let written = match text {
+            Ok(t) => rep.host.write_file(&d.file, t.as_bytes()),
+            Err(e) => {
+                // TLC opens the file before encoding the value
+                let _ = rep.host.write_file(&d.file, b"");
+                Err(match *e {
+                    Fail::Tla(t) => t.msg,
+                    _ => "internal error".into(),
+                })
+            }
+        };
+        match written {
+            Ok(()) => {
+                if !json {
+                    let mut line = String::new();
+                    fmt_str(&format!("CounterExample written: {}", d.file), &mut line);
+                    rep.plain(&line);
+                }
+            }
+            Err(msg) => {
+                if !json {
+                    rep.msg(2405, 1, &format!("Evaluating postcondition {} failed.\n{}", at, msg));
+                }
+                return;
+            }
+        }
+    }
+}
